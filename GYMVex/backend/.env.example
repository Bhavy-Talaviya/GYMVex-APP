# ─── Server Configuration ────────────────────────────────────────────
PORT=5000

# ─── MongoDB Connection ─────────────────────────────────────────────
# MongoDB Atlas or Local MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gymvex?retryWrites=true&w=majority

# ─── Environment ────────────────────────────────────────────────────
NODE_ENV=development
