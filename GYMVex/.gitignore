# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependencies ───────────────────────────────────────────────────
node_modules/
*/node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
lerna-debug.*
.pnpm-debug.log*

# ─── Environment & Secrets (CRITICAL) ──────────────────────────────
.env
.env.*
*.env
backend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Do not ignore example environment files
!.env.example
!*.env.example

# ─── Expo & Web Build ───────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ─── Native Builds & Keys ───────────────────────────────────────────
/ios/
/android/
ios/
android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
*.pem
*.cer
*.crt

# ─── Metro Bundler ──────────────────────────────────────────────────
.metro-health-check*
.metro-cache/

# ─── Logs & Temp Files ──────────────────────────────────────────────
*.log
logs/
temp/
tmp/

# ─── TypeScript & Testing ───────────────────────────────────────────
*.tsbuildinfo
build/
coverage/
*.lcov
.nyc_output/
app-example/

# ─── Operating System Files ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─── IDE & AI Assistants ────────────────────────────────────────────
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.claude/
.gemini/
